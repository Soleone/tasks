{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/backend/{cli,tasks-cli,devServer}.ts",
    "src/**/*.test.{ts,tsx}",
    "src/testing/workspaceBridge.ts",
    "scripts/*.{mjs,ts}"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.{mjs,ts}"],
  "ignore": ["src/components/ui/**", "src/components/soleone/**"],
  "ignoreDependencies": ["postject"],
  "ignoreBinaries": ["rustc", "agent-browser", "win-sync"]
}
