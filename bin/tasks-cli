#!/usr/bin/env bash
set -euo pipefail

# Local PATH shim for the tasks-cli entrypoint. It resolves the repo root
# from this script's location, rebuilds the backend when sources are newer
# than the compiled output, and execs it with system Node. This is the
# development path: fast tsc only, never the SEA bake. The packaged SEA
# binary under src-tauri/binaries/ is only for Tauri dev/bundle/probe runs.
# Resolve symlinks before deriving the repository root. The installed PATH
# entry normally points back into the checkout, but dirname on the symlink
# itself would incorrectly select ~/.local and invoke pnpm there.
source="${BASH_SOURCE[0]}"
while [[ -h "$source" ]]; do
  source_dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ "$source" != /* ]] && source="$source_dir/$source"
done
root="$(cd -P "$(dirname "$source")/.." && pwd)"
compiled="$root/dist/backend/tasks-cli.js"

needs_build() {
  if [[ ! -f "$compiled" ]]; then
    return 0
  fi
  local newer
  newer="$(find "$root/src/backend" -name '*.ts' -newer "$compiled" -print -quit)"
  [[ -n "$newer" ]]
}

if needs_build; then
  pnpm --dir "$root" build:backend >&2
fi

exec node "$compiled" "$@"
