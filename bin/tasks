#!/usr/bin/env bash
set -euo pipefail

windows_root="${TASKS_WINDOWS_ROOT:-/mnt/d/src/wsl/tasks}"
sidecar="${TASKS_WINDOWS_SIDECAR:-$windows_root/src-tauri/binaries/tasks-backend-x86_64-pc-windows-msvc.exe}"

if [[ ! -f "$sidecar" ]]; then
  printf 'Windows sidecar not found: %s\n' "$sidecar" >&2
  printf 'Set TASKS_WINDOWS_ROOT or TASKS_WINDOWS_SIDECAR to the Windows checkout.\n' >&2
  exit 1
fi

# JSON lines to the Windows backend, as a second writer in a Tasks home. There is no default home.
if [[ -z "${TASKS_WINDOWS_HOME:-}" ]]; then
  printf 'Set TASKS_WINDOWS_HOME to the Tasks home, for example /mnt/c/Users/you/Tasks.\n' >&2
  exit 1
fi

exec "$sidecar" --stdio --home "$(wslpath -w "$TASKS_WINDOWS_HOME")" --client cli "$@"
