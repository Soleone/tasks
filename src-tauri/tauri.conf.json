{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tasks",
  "version": "../package.json",
  "identifier": "com.soleone.tasks",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tasks",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tasks-cli"],
    "windows": {
      "nsis": { "installerHooks": "windows/installer-hooks.nsh" }
    }
  }
}
