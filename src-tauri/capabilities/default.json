{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/tasks-cli",
          "sidecar": true,
          "args": [
            "--stdio",
            "--home",
            {
              "validator": "\\S.*"
            },
            "--client",
            "app"
          ]
        }
      ]
    }
  ]
}
