{
  "name": "tasks",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:web:real": "node scripts/dev-web.mjs --real",
    "dev:backend": "pnpm build:backend && node dist/backend/devServer.js",
    "tasks-cli": "pnpm build:backend && node dist/backend/tasks-cli.js",
    "build": "pnpm check && pnpm build:backend && pnpm build:web",
    "build:web": "vp build",
    "dev:demo": "VITE_HOSTED=1 vp dev --port 5175",
    "build:hosted": "VITE_HOSTED=1 vp build --outDir dist/hosted",
    "release:demo": "pnpm build:hosted && vercel deploy dist/hosted --prod --yes --project tasks-demo --scope soleones-projects",
    "release:feedback": "pnpm dlx wrangler deploy -c src/feedback/wrangler.toml",
    "build:backend": "node -e \"require('fs').rmSync('dist/backend', { recursive: true, force: true })\" && tsc -p tsconfig.backend.json",
    "build:test": "node -e \"require('fs').rmSync('test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.backend.json --outDir test-dist",
    "build:backend:bundle": "esbuild src/backend/tasks-cli.ts --bundle --platform=node --format=cjs --outfile=dist/sidecar/tasks-cli.cjs",
    "build:sidecar": "pnpm build:backend:bundle && node scripts/build-sidecar.mjs",
    "build:tauri": "pnpm build:sidecar && tauri build",
    "build:android": "pnpm build:backend:bundle && node scripts/build-android.mjs",
    "dev:native": "node scripts/ensure-sidecar.mjs && tauri dev",
    "ensure:sidecar": "node scripts/ensure-sidecar.mjs",
    "tauri": "tauri",
    "test": "pnpm build:test && node --test --test-timeout=60000 test-dist/backend/*.test.js scripts/*.test.mjs && vp test run",
    "test:sidecar": "pnpm build:sidecar && node scripts/check-sidecar.mjs",
    "lint": "vp lint && node scripts/check-spec-rules.mjs && knip --no-progress",
    "check": "vp check",
    "release": "node scripts/release.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "fractional-indexing": "3.2.0",
    "lucide-react": "^1.41.0",
    "memfs": "4.80.0",
    "motion": "^14.3.0",
    "path-browserify": "^1.0.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sql.js": "^1.15.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@shadcn/lint": "^0.1.0",
    "@soleone/showcase-capture": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.1",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "postject": "^1.0.0-alpha.6",
    "release-it": "^21.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
