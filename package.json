{
  "name": "tasks",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:backend": "pnpm build:backend && node dist/backend/devServer.js",
    "tasks-cli": "pnpm build:backend && node dist/backend/tasks-cli.js",
    "build": "pnpm check && pnpm build:backend && pnpm build:web",
    "build:web": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:backend:bundle": "esbuild src/backend/cli.ts --bundle --platform=node --format=cjs --outfile=dist/sidecar/cli.cjs && esbuild src/backend/tasks-cli.ts --bundle --platform=node --format=cjs --outfile=dist/sidecar/tasks-cli.cjs",
    "build:sidecar": "pnpm build:backend:bundle && node scripts/build-sidecar.mjs",
    "build:tauri": "pnpm build:sidecar && pnpm build && tauri build",
    "build:android": "node scripts/build-android-release.mjs",
    "build:android:debug": "tauri android build --debug --apk -t aarch64",
    "dev:tauri": "node scripts/ensure-sidecar.mjs && tauri dev",
    "dev:native": "node scripts/dev-native.mjs",
    "ensure:sidecar": "node scripts/ensure-sidecar.mjs",
    "tauri": "tauri",
    "test": "pnpm build:backend && node --test dist/backend/*.test.js dist/legacy/backend/*.test.js dist/migration/*.test.js scripts/*.test.mjs && vitest run",
    "test:native:argv": "node scripts/check-native-launch-argv.mjs",
    "test:sidecar": "pnpm build:sidecar && node scripts/check-sidecar.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "lint": "oxlint && node scripts/check-naming.mjs && node scripts/check-spec-rules.mjs && knip --no-progress",
    "check": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "fractional-indexing": "3.2.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "oxlint": "^1.82.0",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.4"
  }
}
